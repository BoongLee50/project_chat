<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moonlighttalk.server.scheduler.mapper.SchedulerMapper">

    <resultMap id="RoomResultMap" type="com.moonlighttalk.server.chat.entity.ChatRoom">
        <id property="id" column="id"/>
        <result property="userA" column="user_a"/>
        <result property="userB" column="user_b"/>
        <result property="status" column="status"/>
        <result property="type" column="type"/>
        <result property="requestId" column="request_id"/>
        <result property="endedAt" column="ended_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectActiveMatchRooms" resultMap="RoomResultMap">
        SELECT * FROM chat_rooms WHERE status = 'ACTIVE' AND type = 'MATCH'
    </select>

    <!-- 종료 시 active_pair_key를 비워 같은 페어의 재매칭을 막지 않는다(02 §1.5) -->
    <update id="endAllActiveMatchRooms">
        UPDATE chat_rooms
        SET status = 'ENDED', ended_at = #{endedAt}, active_pair_key = NULL
        WHERE status = 'ACTIVE' AND type = 'MATCH'
    </update>

    <select id="selectPhotoKeysBefore" resultType="string">
        SELECT ph.storage_key
        FROM post_photos ph
                 JOIN posts p ON p.id = ph.post_id
        WHERE p.session_date &lt; #{sessionDate}
    </select>

    <delete id="deletePhotosBefore">
        DELETE ph FROM post_photos ph
            JOIN posts p ON p.id = ph.post_id
        WHERE p.session_date &lt; #{sessionDate}
    </delete>

    <!--
      사진을 지우면 posts.main_photo_id가 존재하지 않는 사진을 가리키게 된다(FK가 없다 — V11).
      읽는 쪽이 방어하고 있어 화면은 멀쩡하지만, **DB에 거짓말을 남기지 않으려고** 같이 비운다.
      ③단계에서 이 컬럼을 조인에 쓰기 시작하면 떠 있는 값이 곧 버그가 된다.
    -->
    <update id="clearMainPhotosBefore">
        UPDATE posts SET main_photo_id = NULL WHERE session_date &lt; #{sessionDate}
    </update>

    <delete id="deleteStatsBefore">
        DELETE FROM post_stats WHERE session_date &lt; #{sessionDate}
    </delete>

    <delete id="deleteSkipsBefore">
        DELETE FROM feed_skips WHERE session_date &lt; #{sessionDate}
    </delete>

    <delete id="deleteDailyUsageBefore">
        DELETE FROM daily_usage WHERE session_date &lt; #{sessionDate}
    </delete>

    <!-- 번역 무료 쿼터(채팅 2명)도 같은 주기로 비운다. 안 지우면 어제 연 상대가 오늘도 무료가 된다. -->
    <delete id="deleteTranslateTargetsBefore">
        DELETE FROM daily_translate_targets WHERE session_date &lt; #{sessionDate}
    </delete>

    <!--
      사용자별 최신 1건은 남긴다. one_liner를 다음 영업일로 이어받는 원본이라
      이걸 지우면 "하루 한 마디는 유지"(기획서 3-1)가 깨진다.
    -->
    <delete id="deleteStalePosts">
        DELETE p FROM posts p
            JOIN (SELECT user_id, MAX(session_date) AS latest FROM posts GROUP BY user_id) t
                 ON t.user_id = p.user_id
        WHERE p.session_date &lt; #{sessionDate}
          AND p.session_date &lt; t.latest
    </delete>

    <!--
      보관 만료 메시지. 판정 기준은 **방 타입** — 친구를 끊어 ENDED가 된 방도 type은 FRIEND라
      1년 기준을 그대로 적용받는다. 오래된 순으로 뽑아 FIFO로 지운다(02 §1.5).
    -->
    <select id="selectExpiredMessageIds" resultType="string">
        SELECT m.id
        FROM chat_messages m
                 JOIN chat_rooms r ON r.id = m.room_id
        WHERE m.created_at &lt; CASE WHEN r.type = 'FRIEND' THEN #{friendBefore} ELSE #{matchBefore} END
        ORDER BY m.created_at
        LIMIT #{limit}
    </select>

    <delete id="deleteMessagesByIds">
        DELETE FROM chat_messages WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
